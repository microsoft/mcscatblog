---
layout: null
permalink: /feed.xml
---
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url | xml_escape }}</id>
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name | xml_escape }}</name>
    <uri>{{ "/" | absolute_url | xml_escape }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url | xml_escape }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang | xml_escape }}"
    href="{{ '/' | absolute_url | xml_escape }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights>Copyright {{ site.time | date: '%Y' }} {{ site.social.name | xml_escape }}</rights>
  <icon>{{ '/assets/img/favicons/favicon.ico' | absolute_url | xml_escape }}</icon>
  <logo>{{ '/assets/img/favicons/favicon-96x96.png' | absolute_url | xml_escape }}</logo>
{% for post in site.posts limit: 5 %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post_absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post_absolute_url | xml_escape }}</id>
    <content type="html">{{ post.content | feed_content: post_absolute_url | xml_escape }}</content>
    <author>
      <name>{{ post.author | default: site.social.name | xml_escape }}</name>
    </author>
    {% for category in post.categories %}
    <category term="{{ category | xml_escape }}"/>
    {% endfor %}
    {% if post.description %}
    <summary>{{ post.description | xml_escape }}</summary>
    {% else %}
    <summary>{{ post.content | strip_html | normalize_whitespace | truncate: 400 | xml_escape }}</summary>
    {% endif %}
  </entry>
{% endfor %}
</feed>
